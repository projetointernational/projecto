# ------------------------------------------------------------------------------
# PROJECTO - ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# SUPABASE (Database & Authentication)
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CLOUDINARY (Media Storage & Direct Image Uploads)
# Obtain from your Cloudinary Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# BREVO (Transactional Email Notification Service)
# Obtain from your Brevo Account -> SMTP & API
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME=Projecto Notifications
NOTIFICATION_RECEIVER_EMAIL=enquiries@yourdomain.com
